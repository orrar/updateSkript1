-- Чистый Color Picker без силуэта человечка
local function CreateProColorPicker(parent, defaultColor, onColorChanged)
    local Container = Instance.new("Frame")
    Container.Parent = parent
    Container.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
    Container.Size = UDim2.new(1, 0, 0, 134)
    Container.ZIndex = 503
    Instance.new("UICorner", Container).CornerRadius = UDim.new(0, 8)
    
    local h, s, v = defaultColor:ToHSV()

    local PreviewBox = Instance.new("Frame")
    PreviewBox.Parent = Container
    PreviewBox.BackgroundColor3 = defaultColor
    PreviewBox.Position = UDim2.new(0, 8, 0, 8)
    PreviewBox.Size = UDim2.new(0, 36, 0, 80)
    PreviewBox.ZIndex = 504
    Instance.new("UICorner", PreviewBox).CornerRadius = UDim.new(0, 6)

    local SatValBox = Instance.new("ImageButton")
    SatValBox.Parent = Container
    SatValBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
    SatValBox.AutoButtonColor = false
    SatValBox.Position = UDim2.new(0, 52, 0, 8)
    SatValBox.Size = UDim2.new(1, -60, 0, 80)
    SatValBox.Image = "" -- Убрали силуэт человечка
    SatValBox.ZIndex = 504
    Instance.new("UICorner", SatValBox).CornerRadius = UDim.new(0, 6)

    local SVGradient = Instance.new("UIGradient", SatValBox)
    SVGradient.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(0, 0, 0))

    local SVIndicator = Instance.new("Frame")
    SVIndicator.Parent = SatValBox
    SVIndicator.AnchorPoint = Vector2.new(0.5, 0.5)
    SVIndicator.Size = UDim2.new(0, 14, 0, 14)
    SVIndicator.Position = UDim2.new(s, 0, 1 - v, 0)
    SVIndicator.BackgroundTransparency = 1
    SVIndicator.ZIndex = 506
    local svStroke = Instance.new("UIStroke", SVIndicator)
    svStroke.Color = Color3.new(1, 1, 1)
    svStroke.Thickness = 2
    Instance.new("UICorner", SVIndicator).CornerRadius = UDim.new(1, 0)

    local HueSlider = Instance.new("ImageButton")
    HueSlider.Parent = Container
    HueSlider.AutoButtonColor = false
    HueSlider.Position = UDim2.new(0, 8, 0, 98)
    HueSlider.Size = UDim2.new(1, -16, 0, 24)
    HueSlider.Image = ""
    HueSlider.BackgroundColor3 = Color3.new(1, 1, 1)
    HueSlider.ZIndex = 504
    Instance.new("UICorner", HueSlider).CornerRadius = UDim.new(0, 6)

    local HueGradient = Instance.new("UIGradient", HueSlider)
    HueGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
        ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
        ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
        ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
        ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0))
    })

    local HueIndicator = Instance.new("Frame")
    HueIndicator.Parent = HueSlider
    HueIndicator.AnchorPoint = Vector2.new(0.5, 0.5)
    HueIndicator.Size = UDim2.new(0, 8, 1, 4)
    HueIndicator.Position = UDim2.new(h, 0, 0.5, 0)
    HueIndicator.BackgroundColor3 = Color3.new(1, 1, 1)
    HueIndicator.ZIndex = 505
    Instance.new("UICorner", HueIndicator).CornerRadius = UDim.new(0, 4)

    local function ApplyColorUpdate()
        local finalColor = Color3.fromHSV(h, s, v)
        PreviewBox.BackgroundColor3 = finalColor
        SatValBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        onColorChanged(finalColor)
    end

    local updatingSV = false
    local updatingHue = false

    local function LockParentScroll(lock)
        if parent:IsA("ScrollingFrame") then
            parent.ScrollingEnabled = not lock
        end
    end

    SatValBox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            updatingSV = true
            LockParentScroll(true)
        end
    end)

    HueSlider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            updatingHue = true
            LockParentScroll(true)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if updatingSV or updatingHue then
                updatingSV = false
                updatingHue = false
                LockParentScroll(false)
            end
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            if updatingSV then
                local absPos = SatValBox.AbsolutePosition
                local absSize = SatValBox.AbsoluteSize
                s = math.clamp((input.Position.X - absPos.X) / absSize.X, 0, 1)
                v = math.clamp(1 - ((input.Position.Y - absPos.Y) / absSize.Y), 0, 1)
                SVIndicator.Position = UDim2.new(s, 0, 1 - v, 0)
                ApplyColorUpdate()
            elseif updatingHue then
                local absPos = HueSlider.AbsolutePosition
                local absSize = HueSlider.AbsoluteSize
                h = math.clamp((input.Position.X - absPos.X) / absSize.X, 0, 1)
                HueIndicator.Position = UDim2.new(h, 0, 0.5, 0)
                ApplyColorUpdate()
            end
        end
    end)

    return Container
end

local function CreateToggle(parent, textKey, defaultState, callback)
