local function GetConfigData()
    return {
        AimbotEnabled = AimbotEnabled,
        WallCheckEnabled = WallCheckEnabled,
        AimbotSpeedMode = AimbotSpeedMode,
        AimbotTargetBone = AimbotTargetBone,
        UseFOVCircle = UseFOVCircle,
        FOVRadius = FOVRadius,
        TriggerBotEnabled = TriggerBotEnabled,
        SpinBotEnabled = SpinBotEnabled,
        FlyEnabled = FlyEnabled,
        FlySpeed = FlySpeed,
        InfJumpEnabled = InfJumpEnabled,
        BHopEnabled = BHopEnabled,
        AntiKnockbackEnabled = AntiKnockbackEnabled,
        AntiFlingEnabled = AntiFlingEnabled,
        ESPEnabled = ESPEnabled,
        ESPNamesEnabled = ESPNamesEnabled,
        NoClipEnabled = NoClipEnabled,
        CurrentLang = CurrentLang,
        StretchScale = StretchScale,
        MusicCode = MusicInput.Text,
        MusicVolume = GlobalBoomboxSound.Volume,
        WorldColorEnabled = WorldColorEnabled,
        ParticlesEnabled = ParticlesEnabled,
        CurrentParticleType = CurrentParticleType
    }
end

local function ApplyConfigData(data)
    if not data then return end
    AimbotEnabled = data.AimbotEnabled or false
    WallCheckEnabled = data.WallCheckEnabled ~= nil and data.WallCheckEnabled or true
    AimbotSpeedMode = data.AimbotSpeedMode or "Smooth"
    AimbotTargetBone = data.AimbotTargetBone or "Head"
    UseFOVCircle = data.UseFOVCircle ~= nil and data.UseFOVCircle or true
    TriggerBotEnabled = data.TriggerBotEnabled or false
    SpinBotEnabled = data.SpinBotEnabled or false
    FlyEnabled = data.FlyEnabled or false
    InfJumpEnabled = data.InfJumpEnabled or false
    BHopEnabled = data.BHopEnabled or false
    AntiKnockbackEnabled = data.AntiKnockbackEnabled or false
    AntiFlingEnabled = data.AntiFlingEnabled or false
    ESPEnabled = data.ESPEnabled or false
    ESPNamesEnabled = data.ESPNamesEnabled ~= nil and data.ESPNamesEnabled or true
    NoClipEnabled = data.NoClipEnabled or false
    StretchScale = data.StretchScale or 1.0
    if data.MusicCode then MusicInput.Text = data.MusicCode end
    if data.MusicVolume then GlobalBoomboxSound.Volume = data.MusicVolume end
    WorldColorEnabled = data.WorldColorEnabled or false
    ParticlesEnabled = data.ParticlesEnabled or false
    if data.CurrentParticleType then CurrentParticleType = data.CurrentParticleType end
    UpdatePlayerParticles()
end

local function PopulateConfigs()
    for _, child in pairs(ConfigScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    local files = listfiles(ConfigFolder)
    local count = 0
    for _, filePath in ipairs(files) do
        if filePath:match("%.json$") then
            count = count + 1
            local fileName = filePath:match("([^/]+)$"):gsub("%.json$", "")
            local cBtn = Instance.new("TextButton")
            cBtn.Parent = ConfigScroll
            cBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 22)
            cBtn.Size = UDim2.new(1, -4, 0, 24)
            cBtn.Font = Enum.Font.Gotham
            cBtn.Text = "  📁 " .. fileName
            cBtn.TextColor3 = CurrentTextColor
            cBtn.TextSize = 10
            cBtn.TextXAlignment = Enum.TextXAlignment.Left
            cBtn.ZIndex = 504
            Instance.new("UICorner", cBtn).CornerRadius = UDim.new(0, 4)
            table.insert(UITextLabels, cBtn)
            
            cBtn.MouseButton1Click:Connect(function()
                SelectedConfigName = fileName
                ConfigInput.Text = fileName
                SelectedConfigLabel.Text = "Выбран конфиг: " .. fileName
            end)
        end
    end
    ConfigScroll.CanvasSize = UDim2.new(0, 0, 0, count * 28)
end

CreateActionBtn(TabConfigs, "SaveConfig", function()
    local name = ConfigInput.Text
    if name ~= "" then
        pcall(function()
            local data = GetConfigData()
            local encoded = HttpService:JSONEncode(data)
            writefile(ConfigFolder .. "/" .. name .. ".json", encoded)
            PopulateConfigs()
            SelectedConfigName = name
            SelectedConfigLabel.Text = "Сохранен: " .. name
        end)
    end
end)

CreateActionBtn(TabConfigs, "LoadConfig", function()
    local name = SelectedConfigName or ConfigInput.Text
    if name ~= "" then
        pcall(function()
            local path = ConfigFolder .. "/" .. name .. ".json"
            if isfile(path) then
                local content = readfile(path)
                local data = HttpService:JSONDecode(content)
                ApplyConfigData(data)
                SelectedConfigLabel.Text = "Загружен: " .. name
            end
        end)
    end
end)

CreateActionBtn(TabConfigs, "DeleteConfig", function()
    local name = SelectedConfigName or ConfigInput.Text
    if name ~= "" then
        pcall(function()
            local path = ConfigFolder .. "/" .. name .. ".json"
            if isfile(path) then
                delfile(path)
                PopulateConfigs()
                SelectedConfigLabel.Text = "Удален: " .. name
            end
        end)
    end
end)

