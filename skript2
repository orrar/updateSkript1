local function UpdateBGTrans(input)
    local w = BGTransTrack.AbsoluteSize.X
    if w > 0 then
        local relX = math.clamp(input.Position.X - BGTransTrack.AbsolutePosition.X, 0, w)
        local percentage = relX / w
        MenuBGTransparency = percentage * 0.85
        MainFrame.BackgroundTransparency = MenuBGTransparency
        BGTransFill.Size = UDim2.new(percentage, 0, 1, 0)
        BGTransTitle.Text = T("MenuBGTransparency") .. ": " .. math.floor(percentage * 100) .. "%"
    end
end

